{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT e.id, e.ledger_id, e.transaction_id, e.account_id, e.curr, e.debit, e.credit \n            FROM entry e\n            INNER JOIN transaction t ON e.transaction_id = t.id\n            WHERE t.ledger_id = $1\n            ORDER BY e.id DESC\n            LIMIT $2\n            OFFSET $3\n            ",
